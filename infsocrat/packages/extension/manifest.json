{
  "manifest_version": 3,
  "name": "InfSocrat",
  "version": "0.1.0",
  "description": "A first-year companion that fades as you learn: practice exercises with hints instead of answers.",
  "action": {
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
