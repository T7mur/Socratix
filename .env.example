# Application
APP_ENV=development
DEBUG=true

# ELM API
ELM_API_KEY=replace_with_your_elm_api_key
ELM_BASE_URL=https://replace-with-your-elm-api-base-url
ELM_MODEL=replace_with_available_elm_model_id
ELM_TIMEOUT_SECONDS=60

# Supabase PostgreSQL: paste a direct/session-pooler URL (5432); percent-encode passwords.
# The application selects psycopg and requires TLS automatically; no CA file is needed.
DATABASE_URL=postgresql://socratix_api_login:replace_with_password@db.PROJECT_REF.supabase.co:5432/postgres
# Optional operator connection; when omitted, migrations use DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres:replace_with_operator_password@db.PROJECT_REF.supabase.co:5432/postgres

# Auth origin; takes precedence if legacy SUPABASE_URL was a SQL hostname.
SUPABASE_AUTH_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=ES256

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

# Frontend
CORS_ORIGINS=http://localhost:3000
