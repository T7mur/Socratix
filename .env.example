# Application
APP_ENV=development
DEBUG=true

# ELM API
# Any compatible Chat Completions endpoint; include its documented API prefix.
ELM_API_KEY=replace_with_your_elm_api_key
ELM_BASE_URL=https://replace-with-your-elm-api-base-url
ELM_MODEL=replace_with_available_elm_model_id
ELM_TIMEOUT_SECONDS=60
ELM_MAX_ATTEMPTS=3
# Optional aliases fall back to ELM_MODEL when omitted:
# ELM_MODEL_GENERATION=your-generation-model
# ELM_MODEL_REVIEW=your-review-model

# Aiven PostgreSQL
DATABASE_URL=postgresql+psycopg://avnadmin:replace_with_password@replace-with-host.aivencloud.com:12345/defaultdb?sslmode=require

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30

# Frontend
CORS_ORIGINS=http://localhost:3000
